{
  "name": "pulse",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build --base=./",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --test",
    "android:sync": "npm run build && cap sync android",
    "android:open": "cap open android",
    "android:debug": "npm run android:sync && node scripts/android-build.mjs debug",
    "android:bundle": "npm run android:sync && node scripts/android-build.mjs bundle",
    "android:verify": "node scripts/verify-android.mjs"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.3",
    "happy-dom": "^21.0.4",
    "vite": "^6.4.1"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.6.3",
    "@capacitor/share": "^8.0.3"
  }
}
